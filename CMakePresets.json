{
  "version": 6,
  "configurePresets": [
    {
      "name": "ucrt64-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install"
      }
    },
    {
      "name": "debug",
      "inherits": "ucrt64-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "ucrt64-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "capi",
      "inherits": "ucrt64-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SPP_BUILD_CAPI": "ON"
      }
    },
    {
      "name": "moon",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/moon-${hostSystemName}",
      "cacheVariables": {
        "SPP_BUILD_APPS": "ON",
        "SPP_BUILD_MOON": "ON",
        "SPP_BUILD_VALIDATION": "ON",
        "SPP_BUILD_BENCH": "ON",
        "SPP_BUILD_CAPI": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "capi",
      "configurePreset": "capi"
    },
    {
      "name": "moon",
      "configurePreset": "moon"
    }
  ]
}
